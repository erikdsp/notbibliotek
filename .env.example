POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=notbibliotek
# postgres://<user>:<password>@localhost:5432/<database>
DATABASE_URL=postgres://postgres:your_password@localhost:5432/notbibliotek
# OAuth credentials downloaded from Google Cloud
GOOGLE_DRIVE_CREDENTIALS_PATH=./backend/.credentials/google-drive-credentials.json
# Created automatically after the first authorization
GOOGLE_DRIVE_TOKEN_PATH=./backend/.credentials/google-drive-token.json
# Google Drive folder ID from the folder URL, not the folder name
GOOGLE_DRIVE_FOLDER_ID=
CORS_ALLOWED_ORIGIN=http://localhost:5173